<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#F5F3EE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#8C877D"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/col_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_left_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#8C877D"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/n_left_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="#F5F3EE"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/n_left_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/n_left_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#6CD49A"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
        android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_right_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#8C877D"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/n_right_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="#F5F3EE"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/n_right_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/n_right_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#6CD49A"
                android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/col_case"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_case_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#8C877D"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/n_case_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="#F5F3EE"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/n_case_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/n_case_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#6CD49A"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
